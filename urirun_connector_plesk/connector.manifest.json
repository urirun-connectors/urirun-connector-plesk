{
  "id": "plesk",
  "name": "Plesk",
  "status": "available",
  "category": "Infrastructure",
  "summary": "Manage Plesk through vault-backed REST API v2 URI processes.",
  "description": "The connector exchanges a vault-held Plesk administrator login for a REST API key, immediately stores the generated key in the vault, and uses X-API-Key for later autonomous operations. Credentials are never accepted in URI payloads or returned in results.",
  "useCases": [
    "Bootstrap a Plesk REST API key without exposing administrator credentials.",
    "Read domains, clients, subscriptions, and other Plesk API resources.",
    "Execute authorized Plesk API changes through auditable URI processes."
  ],
  "flowExample": [
    "plesk://host/auth/command/bootstrap-api-key",
    "plesk://host/auth/query/status",
    "plesk://host/api/query/request"
  ],
  "requires": [
    "python>=3.10",
    "Plesk Obsidian REST API v2",
    "urirun credential vault"
  ],
  "install": {
    "mode": "urirun-extra",
    "pipSpec": "urirun-connector-plesk @ git+https://github.com/urirun-connectors/urirun-connector-plesk.git@v0.4.0"
  },
  "provenance": "verified",
  "publisher": {
    "name": "if-uri",
    "url": "https://ifuri.com",
    "github": "https://github.com/urirun-connectors"
  },
  "docsUrl": "https://github.com/urirun-connectors/urirun-connector-plesk",
  "keywords": ["plesk", "hosting", "domains", "mail", "rest-api", "vault"],
  "uriSchemes": ["plesk"],
  "routes": [
    "plesk://host/api/command/request",
    "plesk://host/api/query/request",
    "plesk://host/auth/command/bootstrap-api-key",
    "plesk://host/auth/query/status",
    "plesk://host/mailbox/command/create",
    "plesk://host/ftpuser/command/ensure",
    "plesk://host/site/command/publish",
    "plesk://host/site/command/sync",
    "plesk://host/site/command/release-upload",
    "plesk://host/site/command/release-verify",
    "plesk://host/site/command/release-activate",
    "plesk://host/site/command/release-rollback",
    "plesk://host/site/query/release-current",
    "plesk://host/site/query/methods",
    "plesk://host/doctor/query/report"
  ],
  "examples": [
    {
      "title": "Create and store a Plesk API key",
      "uri": "plesk://host/auth/command/bootstrap-api-key",
      "payload": {}
    },
    {
      "title": "List domains",
      "uri": "plesk://host/api/query/request",
      "payload": {"path": "/api/v2/domains"}
    },
    {
      "title": "Dry-run www → httpdocs sync",
      "uri": "plesk://host/site/command/sync",
      "payload": {
        "source_dir": "/repo/www",
        "remote_path": "/httpdocs",
        "host": "prototypowanie.pl",
        "domain": "subactor.com",
        "apply": false
      }
    }
  ],
  "adapterKinds": ["local-function"]
}
