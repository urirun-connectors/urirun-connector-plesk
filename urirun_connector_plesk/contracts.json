{
  "contracts": {
    "auth/command/bootstrap-api-key": {
      "version": "v1",
      "effect": "command",
      "reversible": false,
      "inp": {
        "base_url": "?str",
        "admin_vault_entry_id": "?str",
        "runtime_vault_entry_id": "?str",
        "login": "?str",
        "ip": "?str",
        "description": "?str",
        "vault_url": "?str"
      },
      "out": {
        "base_url": "str",
        "vault_entry_id": "str",
        "authorized": "bool",
        "credential_type": "str"
      },
      "errors": ["precondition-unmet", "degraded-backend"],
      "examples": [
        {
          "payload": {},
          "result": {
            "ok": true,
            "base_url": "https://plesk.example.com:8443",
            "vault_entry_id": "plesk-runtime",
            "authorized": true,
            "credential_type": "api_key"
          }
        }
      ]
    },
    "auth/query/status": {
      "version": "v1",
      "effect": "query",
      "reversible": false,
      "inp": {
        "base_url": "?str",
        "runtime_vault_entry_id": "?str",
        "probe_path": "?str",
        "vault_url": "?str"
      },
      "out": {"base_url": "str", "authorized": "bool", "http_status": "int"},
      "errors": ["precondition-unmet", "degraded-backend"],
      "examples": [
        {
          "payload": {},
          "result": {"ok": true, "base_url": "https://plesk.example.com:8443", "authorized": true, "http_status": 200}
        }
      ]
    },
    "api/query/request": {
      "version": "v1",
      "effect": "query",
      "reversible": false,
      "inp": {"path": "str", "base_url": "?str", "runtime_vault_entry_id": "?str", "vault_url": "?str"},
      "out": {"http_status": "int", "data": "any"},
      "errors": ["precondition-unmet", "degraded-backend"],
      "examples": [
        {"payload": {"path": "/api/v2/domains"}, "result": {"ok": true, "http_status": 200, "data": []}}
      ]
    },
    "api/command/request": {
      "version": "v1",
      "effect": "command",
      "reversible": false,
      "inp": {
        "path": "str",
        "method": "?str",
        "body": "?any",
        "base_url": "?str",
        "runtime_vault_entry_id": "?str",
        "vault_url": "?str"
      },
      "out": {"http_status": "int", "data": "any"},
      "errors": ["precondition-unmet", "degraded-backend"],
      "examples": [
        {
          "payload": {"path": "/api/v2/domains", "method": "POST", "body": {"name": "example.com"}},
          "result": {"ok": true, "http_status": 201, "data": {"id": 1}}
        }
      ]
    },
    "mailbox/command/create": {
      "version": "v1",
      "effect": "command",
      "reversible": false,
      "inp": {
        "email": "str",
        "display_name": "?str",
        "credential_vault_entry_id": "?str",
        "credential_origin": "str",
        "base_url": "?str",
        "runtime_vault_entry_id": "?str",
        "vault_url": "?str",
        "api_path": "?str"
      },
      "out": {
        "email": "str",
        "display_name": "str",
        "created": "bool",
        "credential_vault_entry_id": "str",
        "credential_origin": "str",
        "api_result": "any"
      },
      "errors": ["precondition-unmet", "degraded-backend"],
      "examples": [
        {
          "payload": {
            "email": "agent@example.com",
            "credential_vault_entry_id": "agent-mailbox-runtime",
            "credential_origin": "imap://mail.example.com"
          },
          "result": {
            "ok": true,
            "email": "agent@example.com",
            "display_name": "",
            "created": true,
            "credential_vault_entry_id": "agent-mailbox-runtime",
            "credential_origin": "imap://mail.example.com",
            "api_result": {}
          }
        }
      ]
    },
    "ftpuser/command/ensure": {
      "version": "v1",
      "effect": "command",
      "reversible": false,
      "inp": {
        "name": "?str",
        "home": "?str",
        "domain": "?str",
        "kind": "?str",
        "credential_vault_entry_id": "?str",
        "also_ftp_vault_entry_id": "?str",
        "credential_origin": "?str",
        "base_url": "?str",
        "subscription_vault_entry_id": "?str",
        "enable_ssh": "?bool",
        "vault_url": "?str"
      },
      "out": {
        "kind": "str",
        "name": "str",
        "home": "str",
        "domain": "?str",
        "created": "bool",
        "recreated": "bool",
        "existed": "bool",
        "credential_vault_entry_id": "str",
        "credential_origin": "str",
        "transport_hint": "?str"
      },
      "errors": ["precondition-unmet", "degraded-backend"],
      "examples": [
        {
          "payload": {
            "kind": "system",
            "domain": "subactor.com",
            "credential_vault_entry_id": "plesk-sftp"
          },
          "result": {
            "ok": true,
            "kind": "system",
            "name": "subactor_ssh",
            "home": "/",
            "domain": "subactor.com",
            "created": true,
            "recreated": true,
            "existed": true,
            "credential_vault_entry_id": "plesk-sftp",
            "credential_origin": "https://prototypowanie.pl",
            "transport_hint": "sftp"
          }
        }
      ]
    },
    "site/command/subdomain-ensure": {
      "version": "v1",
      "effect": "command",
      "reversible": false,
      "inp": {
        "parent_domain": "str",
        "subdomain": "str",
        "www_root": "?str",
        "base_url": "?str",
        "subscription_vault_entry_id": "?str",
        "vault_url": "?str"
      },
      "out": {
        "created": "bool",
        "existed": "bool",
        "subdomain": "str",
        "parent_domain": "str",
        "www_root": "str",
        "subdomain_id": "?int"
      },
      "errors": ["precondition-unmet", "degraded-backend"],
      "examples": [
        {
          "payload": {"parent_domain": "subactor.com", "subdomain": "docs"},
          "result": {
            "ok": true,
            "created": false,
            "existed": true,
            "subdomain": "docs.subactor.com",
            "parent_domain": "subactor.com",
            "www_root": "docs.subactor.com",
            "subdomain_id": 308
          }
        }
      ]
    },
    "doctor/query/report": {
      "version": "v1",
      "effect": "query",
      "reversible": false,
      "inp": {},
      "out": {"connector": "str", "version": "str", "status": "str"},
      "errors": [],
      "examples": [
        {"payload": {}, "result": {"ok": true, "connector": "plesk", "version": "0.2.0", "status": "ready"}}
      ]
    }
  },
  "wires": []
}
