      "out": {
        "hostname": "str",
        "strategy": "?str",
        "certificate_name": "?str",
        "probe": "obj",
        "dry_run": "bool"
      },
      "errors": ["precondition-unmet", "degraded-backend"],
      "examples": [
        {
          "payload": {
            "hostname": "docs.subactor.com",
            "origin_ip": "217.160.250.222",
            "apply": false
          },
          "result": {
            "ok": true,
            "dry_run": true,
            "hostname": "docs.subactor.com",
            "note": "set apply=true, AUTONOMY_MUTATIONS_ENABLED=1, PLESK_SSL_APPLY=1"
          }
        }
      ]
    },
